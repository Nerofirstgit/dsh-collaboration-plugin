{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "outDir": "lib",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "lib": [
      "ES2024"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
